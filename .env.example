# PostgreSQL configuration used by Docker Compose
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=inventory_db

# Used when running the FastAPI server directly from the repository root
DATABASE_URL=postgresql+psycopg://inventory_user:replace_with_a_strong_password@localhost:5432/inventory_db

# Frontend origins allowed to call the API (comma separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend API base URL. For a deployed frontend, replace this with your public backend URL.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Seed sample products/customers when the API starts for the first time
AUTO_SEED=true
